# Server-only. Never inlined into the browser bundle.
# Optional lock for public preview URLs (dev/preview servers).
PREVIEW_PASSWORD=

# Used only by a future token-issuer backend. Do not put this in client code.
GEMINI_API_KEY=

# Billing: mock completes on this server. live calls PayPal / PhonePe.
# BYO Gemini key stays free. Set BILLING_ENFORCE=1 to require pay for hosted mint.
BILLING_MODE=mock
BILLING_ENFORCE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_SIG=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox
PHONEPE_WEBHOOK_USER=
PHONEPE_WEBHOOK_PASS=
